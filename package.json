{
  "name": "denturecare",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "틀니 관리 도우미 - 일일 관리 루틴·리콜 알림·보호자 연동",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "cap:sync": "cap sync",
    "add:ios": "cap add ios",
    "add:android": "cap add android",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "test": "vitest run",
    "test:ui": "playwright test",
    "verify": "npm run typecheck && npm test && npm run build",
    "ios:check": "node scripts/check-ios.mjs",
    "ios:prepare": "npm run ios:check && npm run typecheck && npm run build && cap sync ios",
    "ios:run": "npm run ios:prepare && cap open ios",
    "release:check": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.1.2",
    "@capacitor/local-notifications": "^6.1.0",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.1",
    "@supabase/supabase-js": "^2.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "@electric-sql/pglite": "^0.3.16",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22"
  }
}
