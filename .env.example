# Supabase > Project Settings > API 에서 공개 URL과 anon/publishable key를 복사하세요.
# service_role / sb_secret_ 키는 앱에 넣으면 안 됩니다.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY

# App Store 제출 전에 실제 공개 페이지와 운영자 메일을 입력하세요.
VITE_PRIVACY_POLICY_URL=
VITE_SUPPORT_EMAIL=
